# Copy to .env, fill the placeholders, then export into the backend process.
# Spring Boot does not automatically load this file. See rag/README.md.
AI_ENABLED=true
RAG_ENABLED=true
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VECTOR_STORE_ID=vs_replace_with_your_store_id
RAG_RESULT_COUNT=5
RAG_SCORE_THRESHOLD=0.0
FINANCE_TIMEZONE=Europe/Moscow
# VM PostgreSQL through the local SSH tunnel (see docs/database-setup.md).
DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/finance_support
DATABASE_USERNAME=finance_app
DATABASE_PASSWORD=replace_with_vm_database_password

# Use true behind HTTPS in production; false for local HTTP development.
SESSION_COOKIE_SECURE=false
