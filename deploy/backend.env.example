# Copy to /etc/finance-support/backend.env; owner root, mode 600.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/finance_support
DATABASE_USERNAME=finance_app
DATABASE_PASSWORD=replace_me
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# false for HTTP; change to true when enabling HTTPS.
SESSION_COOKIE_SECURE=false
FINANCE_OWNER_ID=11111111-1111-1111-1111-111111111111
FINANCE_TIMEZONE=Europe/Moscow
AI_ENABLED=false
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
RAG_ENABLED=false
OPENAI_VECTOR_STORE_ID=vs_replace_me
RAG_RESULT_COUNT=5
RAG_SCORE_THRESHOLD=0.0
